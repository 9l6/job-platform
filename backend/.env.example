# ===============================
# Server
# ===============================
NODE_ENV=development
PORT=5000

# Frontend URL (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# ===============================
# Database
# ===============================
MONGO_URI=mongodb://127.0.0.1:27017/job_platform

# ===============================
# Auth / Security
# ===============================
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# ===============================
# Email (recommended: SMTP)
# Gmail requires an App Password (NOT your normal password)
# ===============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Job Platform <your_gmail@gmail.com>"

# Optional compatibility (if some code still reads these)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# ===============================
# Platform limits
# ===============================
MAX_DAILY_APPLICATIONS=10
JOB_MATCH_LIMIT=10

# ===============================
# Email behavior
# ===============================
EMAIL_DELAY_MS=2000
ENABLE_JOB_MATCH_EMAIL=true

# ===============================
# Scraper toggles (if used)
# ===============================
ENABLE_AUTO_SCRAPING=false
SCRAPE_HEADLESS=true
SCRAPE_DEBUG=false
SCRAPE_TIMEOUT_MS=45000
SCRAPE_MAX_RETRIES=2
SCRAPE_MIN_DELAY_MS=1200
SCRAPE_MAX_DELAY_MS=2500

# ===============================
# Bayt scraping (if used)
# ===============================
BAYT_DETAILS_LIMIT=20
BAYT_MAX_DETAILS=15
BAYT_MAX_LIST_ITEMS=30
